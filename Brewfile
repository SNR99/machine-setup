# Only what interactive.zsh and extras.zsh need. Nothing else belongs here.

# Fuzzy finder: Ctrl-R history search, Ctrl-T file picker
brew "fzf"
# Grey inline suggestions from history as you type
brew "zsh-autosuggestions"
# Colours commands as you type
brew "zsh-syntax-highlighting"

# Used by the Ctrl-T picker (fd lists the files, bat previews a file, eza a folder)
# and by the aliases in extras.zsh
brew "fd"
brew "bat"
brew "eza"
# grep alias in extras.zsh
brew "ripgrep"
